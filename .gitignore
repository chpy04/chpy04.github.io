# No trailing slash: in a worktree `node_modules` is a symlink to the main
# checkout (see CLAUDE.md), and `node_modules/` only matches real directories.
node_modules
.next/
out/
build/
dist/
*.tsbuildinfo
.env
.env*.local
.DS_Store
coverage/
playwright-report/
test-results/
.pgdata/
scripts/.scratch/

# In-app feedback filed with no GITHUB_REPO configured lands here as
# markdown + screenshots (lib/feedback/local-sink.ts). It is a drop box for
# whoever is working on the code, not a record worth committing.
#
# The leading slash is load-bearing: an unanchored `feedback/` also matches
# `components/feedback/`, and Tailwind's source detection skips whatever
# git ignores — so the widget silently loses every utility class it does
# not share with the rest of the page.
/feedback/
/test-results/
/playwright-report/
/blob-report/

# Claude Code: rules/ and settings.json are checked in (see .claude/README.md);
# per-machine overrides and runtime state are not.
.claude/settings.local.json
.claude/scheduled_tasks.lock
